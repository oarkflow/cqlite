{
  "name": "sujit-sqlite-tools",
  "displayName": "Sujit SQLite Tools",
  "description": "Viewer, schema explorer, and query runner for github.com/sujit/sqlite databases.",
  "version": "0.1.0",
  "publisher": "sujit",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Database",
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:sujitSqlite.databaseViewer",
    "onView:sujitSqliteExplorer",
    "onCommand:sujitSqlite.openDatabase",
    "onCommand:sujitSqlite.refresh",
    "onCommand:sujitSqlite.newQuery",
    "onCommand:sujitSqlite.runQuery",
    "onCommand:sujitSqlite.showTable"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "configuration": {
      "title": "Sujit SQLite",
      "properties": {
        "sujitSqlite.database": {
          "type": "string",
          "default": "",
          "description": "Path to a github.com/sujit/sqlite database file or directory."
        },
        "sujitSqlite.bridgeCommand": {
          "type": "string",
          "default": "go",
          "description": "Command used to launch the SQLite bridge."
        },
        "sujitSqlite.bridgeArgs": {
          "type": "array",
          "default": [
            "run",
            "./cmd/sqlite-vscode-bridge"
          ],
          "items": {
            "type": "string"
          },
          "description": "Arguments used before bridge flags. The default works from this repository workspace."
        },
        "sujitSqlite.resultLimit": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Maximum rows returned by viewer commands."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sujitSqlite",
          "title": "Sujit SQLite",
          "icon": "resources/database.svg"
        }
      ]
    },
    "views": {
      "sujitSqlite": [
        {
          "id": "sujitSqliteExplorer",
          "name": "Databases"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "sujitSqlite.databaseViewer",
        "displayName": "Sujit SQLite Database",
        "selector": [
          {
            "filenamePattern": "*.db"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sujitSqlite.openDatabase",
          "when": "view == sujitSqliteExplorer",
          "group": "navigation"
        },
        {
          "command": "sujitSqlite.refresh",
          "when": "view == sujitSqliteExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sujitSqlite.showTable",
          "when": "view == sujitSqliteExplorer && viewItem == table",
          "group": "inline"
        },
        {
          "command": "sujitSqlite.showTable",
          "when": "view == sujitSqliteExplorer && viewItem == view",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "sujitSqlite.runQuery",
          "when": "editorLangId == sql || editorLangId == sujit-sql",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "sujitSqlite.openDatabase",
        "title": "Sujit SQLite: Open Database",
        "icon": "$(folder-opened)"
      },
      {
        "command": "sujitSqlite.refresh",
        "title": "Sujit SQLite: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "sujitSqlite.newQuery",
        "title": "Sujit SQLite: New Query",
        "icon": "$(new-file)"
      },
      {
        "command": "sujitSqlite.runQuery",
        "title": "Sujit SQLite: Run Query",
        "icon": "$(play)"
      },
      {
        "command": "sujitSqlite.showTable",
        "title": "Show Table Data",
        "icon": "$(table)"
      }
    ],
    "languages": [
      {
        "id": "sujit-sql",
        "aliases": [
          "Sujit SQL"
        ],
        "extensions": [
          ".sujit.sql"
        ]
      }
    ]
  }
}
