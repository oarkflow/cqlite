{
	"name": "cqlite-tools",
	"displayName": "cQlite Tools",
	"description": "Viewer, schema explorer, and query runner for github.com/oarkflow/cqlite databases.",
  "version": "0.1.37",
	"publisher": "sujit",
	"repository": {
		"type": "git",
		"url": "https://github.com/oarkflow/cqlite.git"
	},
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Database",
		"Other"
	],
	"activationEvents": [
		"onCustomEditor:cQlite.databaseViewer",
		"onView:cQliteExplorer",
		"onCommand:cQlite.openDatabase",
		"onCommand:cQlite.openExampleDatabase",
		"onCommand:cQlite.refresh",
		"onCommand:cQlite.newQuery",
		"onCommand:cQlite.runQuery",
		"onCommand:cQlite.showTable"
	],
	"main": "./src/extension.js",
	"contributes": {
		"configuration": {
			"title": "cQlite",
			"properties": {
				"cQlite.database": {
					"type": "string",
					"default": "",
					"description": "Path to a github.com/oarkflow/cqlite database file or directory."
				},
				"cQlite.bridgeCommand": {
					"type": "string",
					"default": "go",
					"description": "Command used to launch the cQlite bridge."
				},
				"cQlite.bridgePath": {
					"type": "string",
					"default": "",
					"description": "Optional absolute path to a prebuilt cqlite-vscode-bridge binary. Takes precedence over every other bridge setting."
				},
				"cQlite.bridgeArgs": {
					"type": "array",
					"default": [
						"run",
						"./cmd/cqlite-vscode-bridge"
					],
					"items": {
						"type": "string"
					},
					"description": "Arguments used before bridge flags. The default works from this repository workspace."
				},
				"cQlite.resultLimit": {
					"type": "number",
					"default": 200,
					"minimum": 1,
					"description": "Maximum rows returned by viewer commands."
				}
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "cQlite",
					"title": "cQlite",
					"icon": "resources/database.svg"
				}
			]
		},
		"views": {
			"cQlite": [
				{
					"id": "cQliteExplorer",
					"name": "Databases"
				}
			]
		},
		"customEditors": [
			{
				"viewType": "cQlite.databaseViewer",
				"displayName": "cQlite Database",
				"selector": [
					{
						"filenamePattern": "*.cq"
					}
				],
				"priority": "default"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "cQlite.openDatabase",
					"when": "view == cQliteExplorer",
					"group": "navigation"
				},
				{
					"command": "cQlite.refresh",
					"when": "view == cQliteExplorer",
					"group": "navigation"
				},
				{
					"command": "cQlite.newQuery",
					"when": "view == cQliteExplorer",
					"group": "navigation"
				},
				{
					"command": "cQlite.openExampleDatabase",
					"when": "view == cQliteExplorer",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "cQlite.showTable",
					"when": "view == cQliteExplorer && viewItem == table",
					"group": "inline"
				},
				{
					"command": "cQlite.showTable",
					"when": "view == cQliteExplorer && viewItem == view",
					"group": "inline"
				}
			],
			"editor/context": [
				{
					"command": "cQlite.runQuery",
					"when": "editorLangId == sql || editorLangId == cqlite-sql",
					"group": "navigation"
				}
			],
			"editor/title": [
				{
					"command": "cQlite.runQuery",
					"when": "editorLangId == sql || editorLangId == cqlite-sql",
					"group": "navigation"
				}
			]
		},
		"commands": [
			{
				"command": "cQlite.openDatabase",
				"title": "cQlite: Open Database",
				"icon": "$(folder-opened)"
			},
			{
				"command": "cQlite.openExampleDatabase",
				"title": "cQlite: Open Example Database",
				"icon": "$(book)"
			},
			{
				"command": "cQlite.refresh",
				"title": "cQlite: Refresh",
				"icon": "$(refresh)"
			},
			{
				"command": "cQlite.newQuery",
				"title": "cQlite: New Query",
				"icon": "$(new-file)"
			},
			{
				"command": "cQlite.runQuery",
				"title": "cQlite: Run Query",
				"icon": "resources/run.svg"
			},
			{
				"command": "cQlite.showTable",
				"title": "Show Table Data",
				"icon": "$(table)"
			}
		],
		"languages": [
			{
				"id": "cqlite-sql",
				"aliases": [
					"cQlite SQL"
				],
				"extensions": [
					".cqlite.sql"
				]
			}
		],
		"keybindings": [
			{
				"command": "cQlite.runQuery",
				"key": "ctrl+enter",
				"mac": "cmd+enter",
				"when": "editorTextFocus && (editorLangId == sql || editorLangId == cqlite-sql)"
			}
		]
	}
}
